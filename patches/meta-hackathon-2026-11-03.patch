+
+/**
+ * WhatsApp ↔ Cravour account linking for logged-in generation.
+ * The Ad Maker page issues a short code (authed); the user sends
+ * "link CODE" to the WhatsApp agent, which maps their phone to the uid
+ * and re-homes any `wa:<phone>` assets they created before linking.
+ */
+const LINKS_COL = "whatsapp_links";
+
+const SESSIONS_COL = "whatsapp_sessions";
+const ASSET_MEMORY_MS = 30 * 60 * 1000;
+
+function makeLinkCode(): string {
+  const alphabet = "ABCDEFGHJKMNPQRSTUVWXYZ23456789";
+  let code = "";
+  for (let i = 0; i < 6; i += 1) code += alphabet[randomInt(alphabet.length)];
+  return code;
+}
+
+/** Find an Ad Maker file by string id or Mongo ObjectId. */
+export async function findCreativeAsset(db: { collection: (name: string) => any }, assetId: string) {
+  const id = String(assetId || "").trim().slice(0, 80);
+  if (!id) return null;
+  const ors: Record<string, unknown>[] = [{ id }, { _id: id }];
+  if (/^[a-f0-9]{24}$/i.test(id)) {
+    try {
+      const { ObjectId } = await import("mongodb");
+      ors.push({ _id: new ObjectId(id) });
+    } catch {
+      /* not an ObjectId */
+    }
+  }
+  return db.collection(ASSETS_COL).findOne({ $or: ors });
+}
+
+export async function createWhatsAppLinkCode(userId: string): Promise<{ code: string; expiresAt: Date } | null> {
+  const db = await tryGetMongoDb(MONGO_DB);
+  if (!db) return null;
+  const code = makeLinkCode();
+  const now = new Date();
+  const expiresAt = new Date(now.getTime() + 15 * 60 * 1000);
+  await db.collection(LINKS_COL).insertOne({
+    _id: `walink_${code}`,
+    code,
+    userId: String(userId),
+    createdAt: now,
+    expiresAt,
+    claimedBy: null,
+    claimedAt: null,
+  } as any);
+  return { code, expiresAt };
+}
+
+export async function claimWhatsAppLink(
+  code: string,
+  phoneDigits: string
+): Promise<{ userId: string } | { error: string }> {
+  const db = await tryGetMongoDb(MONGO_DB);
+  if (!db) return { error: "Linking is not available right now. Try again." };
+  const clean = String(code || "").trim().toUpperCase().replace(/[^A-Z0-9]/g, "").slice(0, 12);
+  if (clean.length < 4) return { error: "That code looks too short. Copy the full code from Ad Maker." };
+  const phone = normalizePhoneDigits(phoneDigits);
+  if (!phone) return { error: "I could not read your number. Try again." };
+  const existing = await db.collection(LINKS_COL).findOne({ code: clean });
+  if (!existing) return { error: "I could not find that code. Make a fresh one in Ad Maker → WhatsApp." };
+  if ((existing as any).claimedBy) return { error: "That code was already used. Make a fresh one in Ad Maker → WhatsApp." };
+  if ((existing as any).expiresAt && new Date((existing as any).expiresAt).getTime() < Date.now()) {
+    return { error: "That code expired. Make a fresh one in Ad Maker → WhatsApp." };
+  }
+  const claimed = await db.collection(LINKS_COL).findOneAndUpdate(
+    { code: clean, claimedBy: null, expiresAt: { $gt: new Date() } },
+    { $set: { claimedBy: phone, claimedAt: new Date() } }
+  );
+  const row = (claimed as any)?.value ?? claimed;
+  if (!row || String((row as any).code || "") !== clean) {
+    return { error: "That code was already used. Make a fresh one in Ad Maker → WhatsApp." };
+  }
+  const userId = String((row as any).userId || "");
+  if (!userId) return { error: "That code has no owner. Make a fresh one in Ad Maker → WhatsApp." };
+  // Persist phone on the user doc so future lookups resolve to the real account + tier.
+  try {
+    await db.collection("users").updateOne(
+      { $or: [{ _id: userId as any }, { uid: userId }] },
+      { $set: { phoneNumber: `+${phone}`, whatsappPhone: phone, whatsappLinkedAt: new Date(), updatedAt: new Date() } }
+    );
+  } catch {
+    /* non-blocking */
+  }
+  // Re-home assets the sender created before linking so Ad Maker history shows them.
+  try {
+    await db.collection(ASSETS_COL).updateMany(
+      { $or: [{ userId: `wa:${phone}` }, { whatsappPhone: phone }, { "metadata.whatsappPhone": phone }] },
+      { $set: { userId, uid: userId, authorId: userId, updatedAt: new Date() } }
+    );
+  } catch {
+    /* non-blocking */
+  }
+  return { userId };
+}
+
+/** The Cravour uid paired with this WhatsApp number, when a link code was claimed. */
+export async function resolveLinkedCravourUserId(phoneDigits: string): Promise<string | null> {
+  const phone = normalizePhoneDigits(phoneDigits);
+  if (!phone) return null;
+  const db = await tryGetMongoDb(MONGO_DB);
+  if (!db) return null;
+  const link = await db.collection(LINKS_COL).findOne(
+    { claimedBy: phone },
+    { sort: { claimedAt: -1 } }
+  );
+  const fromLink = String((link as any)?.userId || "");
+  if (fromLink && !fromLink.startsWith("wa:")) return fromLink;
+  const user = await db.collection("users").findOne({ whatsappPhone: phone });
+  const uid = String((user as any)?.uid || (user as any)?._id || "");
+  if (!uid || uid.startsWith("wa:")) return null;
+  return uid;
+}
+
+/** Remember the file this chat just opened so a later "post it" still works. */
+export async function rememberWhatsAppAsset(phoneDigits: string, assetId: string): Promise<void> {
+  const phone = normalizePhoneDigits(phoneDigits);
+  const id = String(assetId || "").trim().slice(0, 80);
+  if (!phone || !id) return;
+  const db = await tryGetMongoDb(MONGO_DB);
+  if (!db) return;
+  await db.collection(SESSIONS_COL).updateOne(
+    { _id: phone as any },
+    { $set: { assetId: id, updatedAt: new Date() } },
+    { upsert: true }
+  );
+}
+
+export async function recallWhatsAppAsset(phoneDigits: string): Promise<string | null> {
+  const phone = normalizePhoneDigits(phoneDigits);
+  if (!phone) return null;
+  const db = await tryGetMongoDb(MONGO_DB);
+  if (!db) return null;
+  const row = await db.collection(SESSIONS_COL).findOne({ _id: phone as any });
+  const id = String((row as any)?.assetId || "");
+  const updated = new Date((row as any)?.updatedAt || 0).getTime();
+  if (!id || !updated || Date.now() - updated > ASSET_MEMORY_MS) return null;
+  return id;
+}
+
+export async function getWhatsAppLinkStatus(userId: string): Promise<{ linked: boolean; phone?: string }> {
+  try {
+    const db = await tryGetMongoDb(MONGO_DB);
+    if (!db) return { linked: false };
+    const row = await db.collection(LINKS_COL).findOne(
+      { userId: String(userId), claimedBy: { $nin: [null, ""] } },
+      { sort: { claimedAt: -1 } }
+    );
+    if (row && (row as any).claimedBy) return { linked: true, phone: String((row as any).claimedBy) };
+    const user = await db.collection("users").findOne({ $or: [{ _id: String(userId) as any }, { uid: String(userId) }] });
+    const phone = String((user as any)?.whatsappPhone || "");
+    return phone ? { linked: true, phone } : { linked: false };
+  } catch {
+    return { linked: false };
+  }
+}
