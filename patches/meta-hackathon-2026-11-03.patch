+import { describe, expect, test } from "@jest/globals";
+import { extractSharedAssetId } from "../services/whatsappCreativeIntent.js";
+
+describe("extractSharedAssetId", () => {
+  test("pulls the asset id out of an Ad Maker deep link", () => {
+    expect(extractSharedAssetId("Open my file https://cravour.com/ads?asset=asset_abc123XYZ please")).toBe(
+      "asset_abc123XYZ"
+    );
+  });
+
+  test("handles reel links with extra query params", () => {
+    expect(extractSharedAssetId("https://cravour.com/reel?foo=1&asset=asset_k9Qw2x7")).toBe("asset_k9Qw2x7");
+  });
+
+  test("falls back to a bare asset id", () => {
+    expect(extractSharedAssetId("post it asset_7h21ab please")).toBe("asset_7h21ab");
+  });
+
+  test("returns null when there is no asset reference", () => {
+    expect(extractSharedAssetId("make me a flyer for my shawarma spot")).toBeNull();
+    expect(extractSharedAssetId("")).toBeNull();
+  });
+});
