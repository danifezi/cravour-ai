diff --git a/functions/src/__tests__/whatsappAssetLink.test.ts b/functions/src/__tests__/whatsappAssetLink.test.ts
new file mode 100644
index 0000000000..60c2b8040d
--- /dev/null
+++ b/functions/src/__tests__/whatsappAssetLink.test.ts
@@ -0,0 +1,42 @@
+import { describe, expect, test } from "@jest/globals";
+import { callerOwnsAsset, extractSharedAssetId, isPostItCommand, parseLinkCode } from "../services/whatsappCreativeIntent.js";
+
+describe("extractSharedAssetId", () => {
+  test("pulls the asset id out of an Ad Maker deep link", () => {
+    expect(extractSharedAssetId("Open my file https://cravour.com/ads?asset=asset_abc123XYZ please")).toBe(
+      "asset_abc123XYZ"
+    );
+  });
+
+  test("handles reel links with extra query params", () => {
+    expect(extractSharedAssetId("https://cravour.com/reel?foo=1&asset=asset_k9Qw2x7")).toBe("asset_k9Qw2x7");
+  });
+
+  test("falls back to a bare asset id", () => {
+    expect(extractSharedAssetId("post it asset_7h21ab please")).toBe("asset_7h21ab");
+  });
+
+  test("returns null when there is no asset reference", () => {
+    expect(extractSharedAssetId("make me a flyer for my shawarma spot")).toBeNull();
+    expect(extractSharedAssetId("")).toBeNull();
+  });
+
+  test("reads a link code without requiring the message to be only the code", () => {
+    expect(parseLinkCode("link ab12cd")).toBe("AB12CD");
+    expect(parseLinkCode("please link K7M2QP now")).toBe("K7M2QP");
+    expect(parseLinkCode("make me a flyer")).toBeNull();
+  });
+
+  test("treats a bare post-it as the follow-up, not a new brief", () => {
+    expect(isPostItCommand("post it")).toBe(true);
+    expect(isPostItCommand("  Share it. ")).toBe(true);
+    expect(isPostItCommand("post it asset_7h21ab")).toBe(false);
+  });
+
+  test("refuses an empty owner and still accepts the pre-link phone", () => {
+    expect(callerOwnsAsset("", "uid_1", "2348012345678")).toBe(false);
+    expect(callerOwnsAsset("uid_1", "uid_1", "2348012345678")).toBe(true);
+    expect(callerOwnsAsset("wa:2348012345678", "uid_1", "2348012345678")).toBe(true);
+    expect(callerOwnsAsset("someone-else", "uid_1", "2348012345678")).toBe(false);
+  });
+});
