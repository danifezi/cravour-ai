+/**
+ * Transcribe a WhatsApp voice note (or any short audio clip) with
+ * ElevenLabs Scribe v2. Handles the opus-in-ogg blobs WhatsApp sends.
+ * Throws when no ElevenLabs key is configured so callers can fall back.
+ */
+export async function transcribeWithElevenLabs(opts: {
+  audioBuffer: Buffer;
+  mimeType?: string;
+  languageCode?: string;
+  apiKey?: string;
+  modelId?: string;
+}): Promise<string> {
+  const key = resolveElevenKey(opts.apiKey);
+  if (!key) throw new Error("ELEVENLABS_API_KEY is required for ElevenLabs transcription");
+  const mime = opts.mimeType || "audio/ogg";
+  const ext = mime.includes("mp4") || mime.includes("m4a") || mime.includes("aac")
+    ? "m4a"
+    : mime.includes("mp3") || mime.includes("mpeg")
+      ? "mp3"
+      : mime.includes("wav")
+        ? "wav"
+        : "ogg";
+  const form = new FormData();
+  form.append("file", new Blob([new Uint8Array(opts.audioBuffer)], { type: mime }), `voice.${ext}`);
+  form.append("model_id", opts.modelId || process.env.ELEVENLABS_STT_MODEL || "scribe_v2");
+  if (opts.languageCode) form.append("language_code", opts.languageCode);
+
+  const res = await fetch("https://api.elevenlabs.io/v1/speech-to-text", {
+    method: "POST",
+    headers: { "xi-api-key": key },
+    body: form,
+    signal: AbortSignal.timeout(45000) as any,
+  });
+  if (!res.ok) {
+    const errText = await res.text().catch(() => "");
+    throw new Error(`ElevenLabs transcription HTTP ${res.status}: ${errText.slice(0, 200)}`);
+  }
+  const json = (await res.json()) as { text?: string };
+  return String(json?.text || "").trim();
+}
