+ * Pure helper — kept here so unit tests can import it without the agent stack.
+ */
+export function extractSharedAssetId(text: string): string | null {
+  const raw = String(text || "");
+  const match = raw.match(/cravour\.com\/[^\s]*[?&]asset=([A-Za-z0-9_-]{1,80})/i)
+    || raw.match(/\basset_[A-Za-z0-9]{3,20}\b/);
