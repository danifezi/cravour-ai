+
+/**
+ * WhatsApp ↔ Cravour account linking for logged-in generation.
+ * The Ad Maker page issues a short code (authed); the user sends
+ * "link CODE" to the WhatsApp agent, which maps their phone to the uid
+ * and re-homes any `wa:<phone>` assets they created before linking.
+ */
+const LINKS_COL = "whatsapp_links";
+
+function makeLinkCode(): string {
+  const alphabet = "ABCDEFGHJKMNPQRSTUVWXYZ23456789";
+  let code = "";
+  const bytes = new Uint8Array(6);
+  for (let i = 0; i < 6; i += 1) bytes[i] = Math.floor(Math.random() * alphabet.length);
+  for (const b of bytes) code += alphabet[b];
+  return code;
+}
+
+export async function createWhatsAppLinkCode(userId: string): Promise<{ code: string; expiresAt: Date } | null> {
+  const db = await tryGetMongoDb(MONGO_DB);
+  if (!db) return null;
+  const code = makeLinkCode();
+  const now = new Date();
+  const expiresAt = new Date(now.getTime() + 15 * 60 * 1000);
+  await db.collection(LINKS_COL).insertOne({
+    _id: `walink_${code}`,
+    code,
+    userId: String(userId),
+    createdAt: now,
+    expiresAt,
+    claimedBy: null,
+    claimedAt: null,
+  } as any);
+  return { code, expiresAt };
+}
+
+export async function claimWhatsAppLink(
+  code: string,
+  phoneDigits: string
+): Promise<{ userId: string } | { error: string }> {
+  const db = await tryGetMongoDb(MONGO_DB);
+  if (!db) return { error: "Linking is not available right now. Try again." };
+  const clean = String(code || "").trim().toUpperCase().replace(/[^A-Z0-9]/g, "").slice(0, 12);
+  if (clean.length < 4) return { error: "That code looks too short. Copy the full code from Ad Maker." };
+  const row = await db.collection(LINKS_COL).findOne({ code: clean });
+  if (!row) return { error: "I could not find that code. Make a fresh one in Ad Maker → WhatsApp." };
+  if ((row as any).claimedBy) return { error: "That code was already used. Make a fresh one in Ad Maker → WhatsApp." };
+  if ((row as any).expiresAt && new Date((row as any).expiresAt).getTime() < Date.now()) {
+    return { error: "That code expired. Make a fresh one in Ad Maker → WhatsApp." };
+  }
+  const phone = normalizePhoneDigits(phoneDigits);
+  if (!phone) return { error: "I could not read your number. Try again." };
+  const userId = String((row as any).userId || "");
+  if (!userId) return { error: "That code has no owner. Make a fresh one in Ad Maker → WhatsApp." };
+  // Persist phone on the user doc so future lookups resolve to the real account + tier.
+  try {
+    await db.collection("users").updateOne(
+      { $or: [{ _id: userId as any }, { uid: userId }] },
+      { $set: { phoneNumber: `+${phone}`, whatsappPhone: phone, whatsappLinkedAt: new Date(), updatedAt: new Date() } }
+    );
+  } catch {
+    /* non-blocking */
+  }
+  // Re-home assets the sender created before linking so Ad Maker history shows them.
+  try {
+    await db.collection(ASSETS_COL).updateMany(
+      { $or: [{ userId: `wa:${phone}` }, { whatsappPhone: phone }, { "metadata.whatsappPhone": phone }] },
+      { $set: { userId, uid: userId, authorId: userId, updatedAt: new Date() } }
+    );
+  } catch {
+    /* non-blocking */
+  }
+  await db.collection(LINKS_COL).updateOne(
+    { code: clean },
+    { $set: { claimedBy: phone, claimedAt: new Date() } }
+  );
+  return { userId };
+}
+
+export async function getWhatsAppLinkStatus(userId: string): Promise<{ linked: boolean; phone?: string }> {
+  try {
+    const db = await tryGetMongoDb(MONGO_DB);
+    if (!db) return { linked: false };
+    const row = await db.collection(LINKS_COL).findOne({ userId: String(userId), claimedBy: { $ne: null } });
+    if (row) return { linked: true, phone: String((row as any).claimedBy || "") };
+    const user = await db.collection("users").findOne({ $or: [{ _id: String(userId) as any }, { uid: String(userId) }] });
+    const phone = String((user as any)?.whatsappPhone || (user as any)?.phoneNumber || "");
+    return phone ? { linked: true, phone } : { linked: false };
+  } catch {
+    return { linked: false };
+  }
+}
