+/**
+ * POST /creative/whatsapp/link-code
+ * Logged-in user mints a short code shown in Ad Maker → WhatsApp.
+ * Sending "link CODE" to the WhatsApp agent ties that phone to this account,
+ * so image/sound/video generation uses their plan and lands in their history.
+ */
+router.post(
+  "/whatsapp/link-code",
+  asyncHandler(async (req: ExpressRequest, res: ExpressResponse) => {
+    const userId = (req as any).user!.uid;
+    const { createWhatsAppLinkCode } = await import("../services/adMakerAssetStore.js");
+    const link = await createWhatsAppLinkCode(userId);
+    if (!link) {
+      res.status(503).json({ error: "Linking is not available right now. Try again." });
+      return;
+    }
+    res.status(200).json({ success: true, code: link.code, expiresAt: link.expiresAt });
+  })
+);
+
+/** GET /creative/whatsapp/link-status — has this account paired a WhatsApp number? */
+router.get(
+  "/whatsapp/link-status",
+  asyncHandler(async (req: ExpressRequest, res: ExpressResponse) => {
+    const userId = (req as any).user!.uid;
+    const { getWhatsAppLinkStatus } = await import("../services/adMakerAssetStore.js");
+    const status = await getWhatsAppLinkStatus(userId);
+    res.status(200).json({ success: true, ...status });
+  })
+);
+
+/**
+ * POST /creative/whatsapp/share-link
+ * Build the sharable Cravour → WhatsApp-agent link for an owned Ad Maker asset.
+ * The agent resolves cravour.com/ads?asset=<id> back to the file.
+ */
+router.post(
+  "/whatsapp/share-link",
+  asyncHandler(async (req: ExpressRequest, res: ExpressResponse) => {
+    const userId = (req as any).user!.uid;
+    const assetId = String(req.body?.assetId || "").trim().slice(0, 80);
+    if (!assetId) {
+      res.status(400).json({ error: "assetId is required." });
+      return;
+    }
+    const mongo = await getMongo();
+    if (!mongo) {
+      res.status(503).json({ error: "Ad Maker storage is not available right now." });
+      return;
+    }
+    const doc = await mongo
+      .db(MONGO_DB)
+      .collection(ASSETS_COL)
+      .findOne({ $or: [{ _id: assetId as any }, { id: assetId }] });
+    if (!doc) {
+      res.status(404).json({ error: "Asset not found in your Ad Maker history." });
+      return;
+    }
+    const owner = String((doc as any).userId || (doc as any).authorId || "");
+    if (owner && owner !== userId) {
+      res.status(403).json({ error: "You can only share your own Ad Maker file." });
+      return;
+    }
+    const { CRAVOUR_WHATSAPP_E164 } = await import("../services/elevenLabsWhatsAppService.js");
+    const assetUrl = `https://cravour.com/ads?asset=${encodeURIComponent(assetId)}`;
+    const title = String((doc as any).title || "my Cravour ad").slice(0, 80);
+    const message = `Open my Ad Maker file "${title}": ${assetUrl}`;
+    const waNumber = String(CRAVOUR_WHATSAPP_E164 || "").replace(/\D/g, "");
+    const waLink = `https://wa.me/${waNumber}?text=${encodeURIComponent(message)}`;
+    res.status(200).json({ success: true, assetId, assetUrl, waLink, message });
+  })
+);
+
 export default router;
