+import { reelPlayableMedia } from "../src/components/creative/partnerReel";
+
+describe("reel playback", () => {
+  test("plays a gridfs video through the public media route", () => {
+    expect(
+      reelPlayableMedia(
+        { id: "reel 1", videoUrl: "gridfs:abc123", preview: "gridfs:still" },
+        "video"
+      )
+    ).toBe("/public/reel/reel%201/media");
+  });
+
+  test("plays a gridfs image and audio the same way", () => {
+    const item = { id: "asset_1", imageUrl: "gridfs:img", audioUrl: "gridfs:aud" };
+    expect(reelPlayableMedia(item, "image")).toBe("/public/reel/asset_1/media");
+    expect(reelPlayableMedia(item, "audio")).toBe("/public/reel/asset_1/media");
+  });
+
+  test("keeps a normal https video", () => {
+    expect(
+      reelPlayableMedia({ id: "a", videoUrl: "https://cdn.example/ad.mp4" }, "video")
+    ).toBe("https://cdn.example/ad.mp4");
+  });
