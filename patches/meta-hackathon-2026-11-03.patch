+
+/** Resolve a gridfs: ref to the public streaming endpoint when the reel id is known. */
+export function gridfsMediaUrl(ref: string, reelId?: string): string | null {
+  if (!String(ref || "").startsWith("gridfs:")) return null;
+  if (reelId) return `/public/reel/${encodeURIComponent(reelId)}/media`;
+  return null;
+}
+
+/** Any playable audio source: http(s), data:audio, blob, /api, or gridfs (via media endpoint). */
+export function playableAudioUrl(value: unknown, reelId?: string): string | null {
+  const raw = String(value || "").trim();
+  if (!raw) return null;
+  if (/^https?:\/\//i.test(raw) || raw.startsWith("data:audio/") || raw.startsWith("blob:") || raw.startsWith("/api/")) return raw;
+  if (raw.startsWith("gridfs:")) return gridfsMediaUrl(raw, reelId);
+  return null;
+}
+
+/** Best playable media for a reel card: video first, then image, with gridfs fallback. */
+export function reelPlayableMedia(
+  item: { id?: string; imageUrl?: string | null; videoUrl?: string | null; audioUrl?: string | null; preview?: string | null },
+  kind: "video" | "image" | "audio"
+): string | null {
+  const id = item.id;
+  if (kind === "video") {
+    const direct = playableVideoUrl(item.videoUrl);
+    if (direct) return direct;
+    const preview = String(item.preview || "");
+    if (preview.startsWith("gridfs:")) return gridfsMediaUrl(preview, id);
+    return null;
+  }
+  if (kind === "audio") return playableAudioUrl(item.audioUrl, id);
+  const img = usableImage(item.imageUrl, item.preview);
+  if (img) return img;
+  const preview = String(item.preview || "");
+  if (preview.startsWith("gridfs:")) return gridfsMediaUrl(preview, id);
   return null;
 }
 
